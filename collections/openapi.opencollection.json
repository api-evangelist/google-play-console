                "name": "name",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Describes the properties of the ANR rate metric set."
        },
        {
          "info": {
            "name": "Google Play Console Developer Reporting Get error count metric set",
            "type": "http"
